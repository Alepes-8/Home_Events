# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Node / npm workspace artifacts
node_modules/
.npm/
.pnpm-store/

# Local environment files
.env
.env.*

# Lockfile exceptions: keep root lockfiles, ignore package-lock in workspaces if desired
# package-lock.json

# Optional: ignore workspace-generated build output
/dist/
/build/
/coverage/

