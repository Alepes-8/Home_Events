    "deviceId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "detected": {
      "type": "boolean",
      "const": true
    }
  },
  "required": ["deviceId", "timestamp", "detected"],
  "additionalProperties": true
}
