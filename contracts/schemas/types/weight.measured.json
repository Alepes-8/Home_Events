{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "weight.measured",
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "enum": ["kg", "g", "lb"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["deviceId", "value", "unit", "timestamp"],
  "additionalProperties": true
}
