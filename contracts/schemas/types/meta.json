{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meta",
  "type": "object",
  "required": ["firmwareVersion", "capabilities"],
  "properties": {
    "firmwareVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["sensor", "actuator"] },
          "unit": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}