{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "meta",
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "firmwareVersion": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["deviceId", "type", "timestamp"],
  "additionalProperties": true
}
