{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "light.set",
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": ["on", "off"]
    },
    "brightness": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["deviceId", "state", "timestamp"],
  "additionalProperties": true
}
